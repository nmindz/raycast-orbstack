{
  "$schema": "https://www.raycast.com/schemas/extension.json",
  "name": "orbstack",
  "title": "OrbStack",
  "description": "Manage OrbStack containers, images, compose projects, Linux machines, and Kubernetes",
  "icon": "extension-icon.png",
  "author": "nmindz",
  "platforms": [
    "macOS"
  ],
  "categories": [
    "Developer Tools"
  ],
  "license": "MIT",
  "commands": [
    {
      "name": "container_list",
      "title": "Manage Containers",
      "subtitle": "OrbStack",
      "description": "List and manage Docker containers",
      "mode": "view",
      "preferences": [
        {
          "name": "groupContainersByState",
          "type": "checkbox",
          "required": false,
          "default": false,
          "label": "Group containers by state",
          "description": "Group containers by their state (running, exited, etc.)"
        }
      ]
    },
    {
      "name": "projects_list",
      "title": "Manage Compose Projects",
      "subtitle": "OrbStack",
      "description": "Manage Docker Compose Projects",
      "mode": "view"
    },
    {
      "name": "image_list",
      "title": "Manage Images",
      "subtitle": "OrbStack",
      "description": "List and manage Docker images",
      "mode": "view"
    },
    {
      "name": "machine_list",
      "title": "Manage Linux Machines",
      "subtitle": "OrbStack",
      "description": "List and manage Linux machines",
      "mode": "view"
    },
    {
      "name": "create_machine",
      "title": "Create Linux Machine",
      "subtitle": "OrbStack",
      "description": "Create a new Linux machine",
      "mode": "view"
    },
    {
      "name": "kubernetes",
      "title": "Manage Kubernetes",
      "subtitle": "OrbStack",
      "description": "Start or stop Kubernetes cluster",
      "mode": "view"
    },
    {
      "name": "start-orbstack",
      "title": "Start OrbStack",
      "subtitle": "OrbStack",
      "description": "Start the OrbStack application",
      "mode": "no-view"
    },
    {
      "name": "stop-orbstack",
      "title": "Stop OrbStack",
      "subtitle": "OrbStack",
      "description": "Stop the OrbStack application",
      "mode": "no-view"
    }
  ],
  "preferences": [
    {
      "name": "socketPath",
      "type": "textfield",
      "required": false,
      "title": "Docker Socket Path",
      "description": "Path to Docker socket",
      "default": "/var/run/docker.sock",
      "placeholder": "/var/run/docker.sock"
    }
  ],
  "dependencies": {
    "@raycast/api": "^1.104.5",
    "@raycast/utils": "^1.17.0",
    "@priithaamer/dockerode": "^3.3.1-priithaamer.1"
  },
  "overrides": {
    "tar-fs": ">=3.1.1"
  },
  "devDependencies": {
    "@raycast/eslint-config": "^2.0.4",
    "@types/node": "22.13.10",
    "@types/react": "19.0.10",
    "eslint": "^9.22.0",
    "prettier": "^3.5.3",
    "typescript": "^5.8.2"
  },
  "scripts": {
    "build": "ray build",
    "dev": "ray develop",
    "fix-lint": "ray lint --fix",
    "lint": "ray lint",
    "prepublishOnly": "echo \"\\n\\nIt seems like you are trying to publish the Raycast extension to npm.\\n\\nIf you did intend to publish it to npm, remove the \\`prepublishOnly\\` script and rerun \\`npm publish\\` again.\\nIf you wanted to publish it to the Raycast Store instead, use \\`npm run publish\\` instead.\\n\\n\" && exit 1",
    "publish": "npx @raycast/api@latest publish"
  }
}
